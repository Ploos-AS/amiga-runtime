# Reproducible AROS/m68k source pin used by automated qualification.
#
# SourceForge nightly binary directories rotate and have repeatedly disappeared
# while CI still referenced them. Keep the authoritative source identity here;
# runtime acquisition/build tooling may cache a derived binary, but it must
# remain traceable to this exact upstream commit.
AROS_SOURCE_REPOSITORY=https://github.com/aros-development-team/AROS.git
AROS_SOURCE_COMMIT=2f742a82f579ad49a7c32d8044799913792656d7
AROS_SOURCE_TARGET=amiga-m68k

# A nightly binary may be supplied as an optimization/cache only. It is not the
# reproducibility anchor and therefore is deliberately not pinned to a rotating
# SourceForge date here.
AROS_BUILD_DATE=
AROS_ARCHIVE=
