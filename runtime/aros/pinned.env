# AROS/m68k runtime acquisition policy.
#
# AROS nightly directories are rolling and old dated binary paths may disappear.
# Resolve the currently published amiga-m68k boot ISO through AROS' own nightly
# index, then verify/record the exact archive SHA-256 in qualification evidence.
# This is the same acquisition pattern already proven in Ploos-AS/AmiGuard CI.
AROS_INDEX_URL=https://aros.sourceforge.io/cgi-bin/files?lang=en&type=nightly2
AROS_TARGET=amiga-m68k-boot-iso

# Source identity is documentation/fallback only. It is deliberately not part
# of the normal runtime acquisition path.
AROS_SOURCE_REPOSITORY=https://github.com/aros-development-team/AROS.git
AROS_SOURCE_COMMIT=2f742a82f579ad49a7c32d8044799913792656d7
AROS_SOURCE_TARGET=amiga-m68k
