# Pinned prebuilt AROS/m68k runtime used by automated qualification.
#
# Normal qualification consumes an upstream binary artifact; amiga-runtime does
# not build AROS or its cross-toolchain.  The date and filename are explicit so
# CI never silently follows "latest".  The upstream .md5 sidecar is fetched and
# verified before the archive is accepted; a SHA-256 is recorded in our local
# manifest/evidence as well.
AROS_BUILD_DATE=20260904
AROS_ARCHIVE=AROS-20260904-amiga-m68k-boot-iso.zip
AROS_ARCHIVE_URL=https://downloads.sourceforge.net/project/aros/nightly2/20260904/Binaries/AROS-20260904-amiga-m68k-boot-iso.zip
AROS_MD5_URL=https://downloads.sourceforge.net/project/aros/nightly2/20260904/Binaries/AROS-20260904-amiga-m68k-boot-iso.zip.md5
AROS_TARGET=amiga-m68k

# Source identity is documentation/fallback only. It is deliberately not part
# of the normal runtime acquisition path.
AROS_SOURCE_REPOSITORY=https://github.com/aros-development-team/AROS.git
AROS_SOURCE_COMMIT=2f742a82f579ad49a7c32d8044799913792656d7
AROS_SOURCE_TARGET=amiga-m68k
