# Pinned upstream AROS/m68k nightly used by automated qualification.
# M2 boots from the extracted ISO system tree, so the boot-floppy artifact is
# deliberately not required by CI. Keep acquisition tied to a known published
# m68k boot ISO instead of requiring two independently rotating nightly files.
AROS_BUILD_DATE=20260904
AROS_ARCHIVE=AROS-20260904-amiga-m68k-boot-iso.zip
# SHA-256 is recorded in the generated manifest. Set AROS_SHA256 here when a
# long-lived upstream/archive pin is available; upstream MD5 is always checked.
