#!/bin/sh
set -eu

program=${1:?usage: run-hunk PROGRAM PROFILE [ARGS...]}
profile=${2:?usage: run-hunk PROGRAM PROFILE [ARGS...]}
shift 2
payload_args="$*"
PROFILES=${AMIGA_RUNTIME_PROFILES:-/opt/amiga-runtime/profiles}
AROS_DIR=${AROS_RUNTIME_DIR:-/opt/amiga-runtime/aros}
AROS_ISO=${AROS_BOOT_IMAGE_PREPARED:-"${AROS_DIR}/aros.iso"}
AROS_ROM=${AROS_ROM_PREPARED:-"${AROS_DIR}/aros-rom.bin"}
AROS_EXT=${AROS_EXT_PREPARED:-"${AROS_DIR}/aros-ext.bin"}
EVIDENCE=${AMIGA_RUNTIME_EVIDENCE:-/work/evidence}
TIMEOUT=${AMIGA_RUNTIME_TIMEOUT:-60}
GENERATOR=${AMIGA_RUNTIME_FS_UAE_GENERATOR:-/opt/amiga-runtime/lib/generate-fs-uae-config.py}
MARKER=AMIGA_RUNTIME_PAYLOAD_OK

mkdir -p "$EVIDENCE"
rm -f "$EVIDENCE/$MARKER" "$EVIDENCE/guest-rc.txt"
test -f "$program" || { echo "program not found: $program" >&2; exit 66; }
test -f "$PROFILES/$profile.conf" || { echo "unknown profile: $profile" >&2; exit 66; }
test -s "$AROS_ISO" || { echo "AROS ISO not prepared: $AROS_ISO" >&2; exit 69; }
test -s "$AROS_ROM" || { echo "AROS ROM not prepared: $AROS_ROM" >&2; exit 69; }
test -s "$AROS_EXT" || { echo "AROS EXT ROM not prepared: $AROS_EXT" >&2; exit 69; }
test -f "$GENERATOR" || { echo "missing FS-UAE config generator: $GENERATOR" >&2; exit 69; }

cp "$program" "$EVIDENCE/payload"
sha256sum "$program" > "$EVIDENCE/payload.sha256"

system_root="$AROS_DIR/system-root"
startup_path_file="$AROS_DIR/system-startup-sequence-path.txt"
test -d "$system_root" || { echo "missing prepared AROS system root" >&2; exit 69; }
test -s "$startup_path_file" || { echo "missing prepared AROS Startup-Sequence path" >&2; exit 69; }
startup_path=$(cat "$startup_path_file")
test -s "$startup_path" || { echo "missing prepared AROS Startup-Sequence: $startup_path" >&2; exit 69; }

# Boot the same writable System: tree used by the qualified AROS guest path.
# Keep the pristine prepared tree intact by restoring Startup-Sequence after
# the run; the payload and result markers live on the separate Evidence: drive.
original="$startup_path.amiga-runtime-original"
cp "$startup_path" "$original"
trap 'cp "$original" "$startup_path" 2>/dev/null || true; rm -f "$original"' EXIT HUP INT TERM
cat >"$startup_path" <<EOF
C:Assign >NIL: T: RAM:
C:Assign >NIL: ENV: RAM:
C:Assign >NIL: ENVARC: RAM:
C:Assign >NIL: LIBS: System:Libs
C:Assign >NIL: C: System:C
C:Assign >NIL: DEVS: System:Devs
C:Assign >NIL: L: System:L
Echo "AMIGA_RUNTIME_STARTUP_ENTERED" >Evidence:startup-entered.txt
Echo "amiga-runtime payload start"
Evidence:payload $payload_args >Evidence:guest-console.txt
Echo "\$RC" >Evidence:guest-rc.txt
If "\$RC" EQ "0"
  Echo "$MARKER" >Evidence:$MARKER
EndIf
Echo "AMIGA_RUNTIME_STARTUP_DONE" >Evidence:startup-done.txt
EOF

config="$EVIDENCE/fs-uae.conf"
cat >"$config" <<EOF
[fs-uae]
amiga_model = A1200
kickstart_file = $AROS_ROM
kickstart_ext_file = $AROS_EXT
hard_drive_0 = $system_root
hard_drive_0_label = System
hard_drive_0_boot_priority = 20
hard_drive_1 = $EVIDENCE
hard_drive_1_label = Evidence
hard_drive_1_boot_priority = -20
cdrom_drive_0 = $AROS_ISO
cdrom_drive_0_media = 0
fullscreen = 0
window_width = 640
window_height = 512
EOF

XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/amiga-runtime-xdg}
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"
export XDG_RUNTIME_DIR
export LIBGL_ALWAYS_SOFTWARE=1

set +e
timeout "$TIMEOUT" xvfb-run -a -s '-screen 0 1024x768x24 +extension GLX' fs-uae "$config" \
    >"$EVIDENCE/fs-uae.stdout.log" 2>"$EVIDENCE/fs-uae.stderr.log"
rc=$?
set -e

if [ -s "$EVIDENCE/$MARKER" ]; then
    status=PASS
else
    status=FAIL
fi

python3 - "$EVIDENCE/result.json" "$rc" "$profile" "$program" "$status" <<'PY'
import json, pathlib, sys
out, rc, profile, program, status = sys.argv[1:]
e = pathlib.Path(out).parent
guest_rc = None
p = e / "guest-rc.txt"
if p.exists():
    try: guest_rc = int(p.read_text().strip())
    except ValueError: pass
data = {
    "schema": "amiga-runtime-result-v1",
    "qualification_level": "Q2/Q3-hunk",
    "runtime": "aros-hunk",
    "emulator": "fs-uae",
    "profile": profile,
    "program": pathlib.Path(program).name,
    "emulator_exit_code": int(rc),
    "guest_rc": guest_rc,
    "guest_payload_executed": (e / "AMIGA_RUNTIME_PAYLOAD_OK").exists(),
    "status": status,
}
pathlib.Path(out).write_text(json.dumps(data, indent=2) + "\n")
PY

[ "$status" = PASS ]
