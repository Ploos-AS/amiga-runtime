#!/bin/sh
set -eu
payload=${1:?usage: qualify-classic-contract PAYLOAD_DIR PROFILE}
profile=${2:?usage: qualify-classic-contract PAYLOAD_DIR PROFILE}
PROFILES=${AMIGA_RUNTIME_PROFILES:-/opt/amiga-runtime/profiles}
EVIDENCE=${AMIGA_RUNTIME_EVIDENCE:-/work/evidence}
TIMEOUT=${AMIGA_RUNTIME_TIMEOUT:-120}
FS_UAE=${FS_UAE:-fs-uae}
ROM=${AMIGA_RUNTIME_KICKSTART_ROM:?set AMIGA_RUNTIME_KICKSTART_ROM to a legal Kickstart ROM}
SYSTEM=${AMIGA_RUNTIME_SYSTEM_DIR:?set AMIGA_RUNTIME_SYSTEM_DIR to a legal bootable AmigaOS directory}

contract="$payload/amiga-runtime.json"
test -s "$contract"
test -f "$PROFILES/$profile.conf" || { echo "unknown profile: $profile" >&2; exit 66; }
test -f "$ROM" || { echo "Kickstart ROM not found" >&2; exit 66; }
test -d "$SYSTEM" || { echo "AmigaOS system directory not found" >&2; exit 66; }
command -v "$FS_UAE" >/dev/null 2>&1

mkdir -p "$EVIDENCE"
rm -rf "$EVIDENCE/Test"
mkdir -p "$EVIDENCE/Test"
cp -R "$payload"/. "$EVIDENCE/Test/"

# Work on an ephemeral copy of the user-supplied system. Proprietary files
# remain outside the repository and artifacts; the source tree is never modified.
rm -rf "$EVIDENCE/System"
mkdir -p "$EVIDENCE/System"
cp -R "$SYSTEM"/. "$EVIDENCE/System/"
test -f "$EVIDENCE/System/S/Startup-Sequence" || {
    echo "AmigaOS system has no S/Startup-Sequence" >&2
    exit 66
}
cp "$EVIDENCE/System/S/Startup-Sequence" "$EVIDENCE/System/S/Startup-Sequence.amiga-runtime-original"
script=$(python3 - "$contract" <<'PY'
import json,sys
c=json.load(open(sys.argv[1]))
p=c.get("payload",{}).get("script")
if not p: raise SystemExit("contract has no payload.script")
print(p)
PY
)
case "$script" in /*|*".."*) echo "unsafe payload.script" >&2; exit 65 ;; esac
{
    printf '\n; amiga-runtime classic qualification hook\n'
    printf 'Execute TEST:%s\n' "$script"
} >> "$EVIDENCE/System/S/Startup-Sequence"

python3 - "$contract" "$EVIDENCE/Test" <<'PY'
import json,pathlib,sys
c=json.load(open(sys.argv[1])); root=pathlib.Path(sys.argv[2]).resolve()
def safe(rel):
    p=pathlib.Path(rel)
    if p.is_absolute() or ".." in p.parts:
        raise SystemExit(f"unsafe contract path: {rel}")
    q=(root/p).resolve()
    if root not in q.parents and q != root:
        raise SystemExit(f"path escapes payload: {rel}")
    return q
payload=c.get("payload",{})
paths=[]
for key in ("library","program","script"):
    if key in payload: paths.append(payload[key])
paths += payload.get("programs",[])
for rel in paths:
    p=safe(rel)
    if not p.is_file(): raise SystemExit(f"missing payload: {rel}")
result=c.get("result",{})
logs=result.get("logs",[])
if "log" in result: logs.insert(0,result["log"])
if not logs: raise SystemExit("contract has no result log")
for rel in logs: safe(rel)
if not result.get("required_lines"): raise SystemExit("contract has no required_lines")
PY

machine=$(sed -n 's/^machine=//p' "$PROFILES/$profile.conf")
cpu=$(sed -n 's/^cpu=//p' "$PROFILES/$profile.conf")
case "$machine" in a500) model=A500 ;; a500plus) model=A500+ ;; a1200) model=A1200 ;; *) echo "unsupported machine" >&2; exit 65 ;; esac

config="$EVIDENCE/classic.fs-uae"
cat >"$config" <<EOF
[fs-uae]
amiga_model = $model
kickstart_file = $ROM
cpu = $cpu
hard_drive_0 = $EVIDENCE/System
hard_drive_0_label = DH0
hard_drive_1 = $EVIDENCE/Test
hard_drive_1_label = TEST
accuracy = -1
uae_cpu_speed = max
fullscreen = 0
EOF

bsdsocket=$(python3 - "$contract" <<'PY'
import json,sys
c=json.load(open(sys.argv[1]))
print("1" if c.get("requirements",{}).get("bsdsocket_library") is True else "0")
PY
)
if test "$bsdsocket" = 1; then
    printf 'bsdsocket_library = 1\n' >>"$config"
fi

cat >"$EVIDENCE/RUN-ME.txt" <<EOF
Classic AmigaOS qualification payload is mounted as TEST:.
The temporary SYSTEM: copy has been instrumented to execute:
  Execute TEST:$script
Result logs and required markers are defined by amiga-runtime.json.
The source AmigaOS system directory is never modified.
EOF

XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/tmp/amiga-runtime-xdg}
mkdir -p "$XDG_RUNTIME_DIR"; chmod 0700 "$XDG_RUNTIME_DIR"; export XDG_RUNTIME_DIR
export LIBGL_ALWAYS_SOFTWARE=1
set +e
timeout "$TIMEOUT" xvfb-run -a -s '-screen 0 1024x768x24 +extension GLX' "$FS_UAE" "$config" >"$EVIDENCE/fs-uae.stdout.log" 2>"$EVIDENCE/fs-uae.stderr.log"
emu_rc=$?
set -e

set +e
python3 - "$contract" "$EVIDENCE/Test" "$EVIDENCE/verification.json" <<'PY'
import json,pathlib,sys
contract_path,root_arg,out=sys.argv[1:]
c=json.load(open(contract_path)); root=pathlib.Path(root_arg).resolve()
def safe(rel):
    p=pathlib.Path(rel)
    if p.is_absolute() or ".." in p.parts: raise SystemExit(2)
    q=(root/p).resolve()
    if root not in q.parents and q != root: raise SystemExit(2)
    return q
r=c["result"]; logs=list(r.get("logs",[]))
if "log" in r and r["log"] not in logs: logs.insert(0,r["log"])
lines=[]
missing_logs=[]
for rel in logs:
    p=safe(rel)
    if not p.is_file(): missing_logs.append(rel); continue
    lines.extend(p.read_text(errors="replace").splitlines())
required=r["required_lines"]
missing=[x for x in required if x not in lines]
status="PASS" if not missing_logs and not missing else "FAIL"
pathlib.Path(out).write_text(json.dumps({"status":status,"logs":logs,"missing_logs":missing_logs,"required_lines":required,"missing_lines":missing},indent=2)+"\n")
raise SystemExit(0 if status=="PASS" else 1)
PY
verify_rc=$?
set -e
if test "$verify_rc" -eq 0; then status=PASS; else status=FAIL; fi

python3 - "$EVIDENCE/result.json" "$profile" "$emu_rc" "$status" <<'PY'
import json,pathlib,sys
out,profile,rc,status=sys.argv[1:]
pathlib.Path(out).write_text(json.dumps({
 "schema":"amiga-runtime-result-v1","qualification_level":"classic-contract",
 "runtime":"amigaos","emulator":"fs-uae","profile":profile,
 "emulator_exit_code":int(rc),"status":status},indent=2)+"\n")
PY
test "$status" = PASS
