#!/bin/sh
set -eu

op=${1:-}
shift || true
bin=${FELLOWNG_BIN:-fellowng-sdl}

json_escape() {
    sed 's/\\/\\\\/g; s/"/\\"/g'
}

probe() {
    if ! command -v "$bin" >/dev/null 2>&1; then
        printf '{"schema":1,"backend":"fellowng","status":"unavailable","reason":"binary-not-found"}\n'
        exit 69
    fi
    version=$("$bin" --version 2>&1 | head -n1 || true)
    printf '{"schema":1,"backend":"fellowng","status":"available","version":"%s","automation":"fellowng.runtime-result.v1"}\n' "$(printf '%s' "$version" | json_escape)"
}

run_aros() {
    profile=${1:-a1200-020-aros}
    max_pumps=${FELLOWNG_MAX_PUMPS:-16384}
    assets=${FELLOWNG_AROS_ASSETS:-/opt/amiga-runtime/aros}
    evidence=${AMIGA_RUNTIME_EVIDENCE:-/work/evidence}
    mkdir -p "$evidence"

    rom=${FELLOWNG_ROM:-$assets/aros-rom.bin}
    ext=${FELLOWNG_EXT_ROM:-$assets/aros-ext.bin}
    adf=${FELLOWNG_BOOT_ADF:-}
    live=${FELLOWNG_LIVE_ROOT:-}
    [ -s "$rom" ] || { echo "FellowNG AROS ROM unavailable" >&2; exit 66; }

    case "$profile" in
        a1200-020|a1200-020-aros) cpu=68020 ;;
        a1200-030) cpu=68030 ;;
        *) echo "FellowNG backend does not yet map profile: $profile" >&2; exit 65 ;;
    esac

    mode=runtime-boot-deep
    set -- "$bin" "--$mode" --result-json --max-pumps "$max_pumps" \
        -s "kickstart_rom_file=$rom" -s "cpu_type=$cpu"
    if [ -s "$ext" ]; then
        set -- "$@" -s "kickstart_rom_file_ext=$ext"
    fi

    # Desktop qualification is enabled only when the AROS boot floppy and
    # extracted Live CD root are explicitly available. The prepared
    # amiga-runtime aros.iso is a CD image, not a floppy image.
    if [ -n "$adf" ] && [ -s "$adf" ] && [ -n "$live" ] && [ -d "$live" ]; then
        mode=runtime-boot-desktop
        set -- "$bin" "--$mode" --result-json --max-pumps "$max_pumps" \
            -s "kickstart_rom_file=$rom" -s "cpu_type=$cpu"
        if [ -s "$ext" ]; then set -- "$@" -s "kickstart_rom_file_ext=$ext"; fi
        set -- "$@" -s "floppy0=$adf" -s "floppy0_enabled=yes" \
            -s "floppy0_readonly=yes" -s "autoconfig=yes" \
            -s "filesystem=ro,AROS Live CD:$live"
    fi

    SDL_VIDEODRIVER=${SDL_VIDEODRIVER:-dummy} SDL_AUDIODRIVER=${SDL_AUDIODRIVER:-dummy} "$@" | tee "$evidence/fellowng-runtime.log"
}

case "$op" in
  probe) probe ;;
  run|qualify)
    sub=${1:-aros}; shift || true
    case "$sub" in
      aros) run_aros "$@" ;;
      *) echo "usage: backend-fellowng $op aros [PROFILE]" >&2; exit 64 ;;
    esac
    ;;
  *) echo "usage: backend-fellowng probe|run|qualify" >&2; exit 64 ;;
esac
