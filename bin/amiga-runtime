#!/bin/sh
set -eu

PROFILES=${AMIGA_RUNTIME_PROFILES:-/opt/amiga-runtime/profiles}

usage() {
    cat <<'EOF'
usage:
  amiga-runtime self-test
  amiga-runtime profiles
  amiga-runtime prepare-aros
  amiga-runtime prepare-amiberry
  amiga-runtime prepare-copperline
  amiga-runtime qualify-aros-boot [PROFILE] [--emulator fs-uae|amiberry|fellowng|copperline]
  amiga-runtime qualify-aros-arexx
  amiga-runtime backends
  amiga-runtime compare [PROFILE] --emulators LIST
  amiga-runtime targets
  amiga-runtime test PROGRAM [--runtime aros|fs-uae|amiberry|fellowng|free-native] [--profile PROFILE]\n  amiga-runtime test-hunk PROGRAM [--profile PROFILE]
EOF
}

case "${1:-}" in
    self-test)
        command -v fs-uae >/dev/null
        command -v python3 >/dev/null
        command -v timeout >/dev/null
        command -v prepare-aros >/dev/null
        command -v run-aros >/dev/null
        command -v qualify-aros-boot >/dev/null
        command -v qualify-aros-arexx >/dev/null
        test -d "$PROFILES"
        test -f /opt/amiga-runtime/lib/write-result.py
        echo 'amiga-runtime M1 harness self-test: PASS'
        ;;
    backends)
        printf '%s\n' 'fs-uae stable' 'amiberry adapter' 'fellowng integration' 'copperline adapter'
        ;;
    targets)
        jq -r '.targets[] | [.id,.arch,.runtime,((.backends // [])|join(","))] | @tsv' /opt/amiga-runtime/runtime/targets.json
        ;;
    profiles)
        find "$PROFILES" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' | sed 's/\.conf$//' | sort
        ;;
    prepare-aros)
        exec prepare-aros
        ;;
    prepare-amiberry)
        exec prepare-amiberry
        ;;
    prepare-copperline)
        exec prepare-copperline
        ;;
    qualify-aros-boot)
        shift
        profile=a1200-020-aros
        emulator=fs-uae
        if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then profile=$1; shift; fi
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --emulator) emulator=${2:?missing emulator}; shift 2 ;;
                *) echo "unknown argument: $1" >&2; exit 64 ;;
            esac
        done
        case "$emulator" in
            fs-uae) exec backend-fs-uae qualify-aros-boot "$profile" ;;
            amiberry) exec backend-amiberry qualify-aros-boot "$profile" ;;
            fellowng) exec backend-fellowng qualify aros "$profile" ;;
            copperline) exec backend-copperline qualify-aros-boot "$profile" ;;
            *) echo "unsupported emulator: $emulator" >&2; exit 65 ;;
        esac
        ;;
    qualify-aros-arexx)
        shift
        exec qualify-aros-arexx "$@"
        ;;
    compare)
        shift
        profile=a1200-020-aros
        emulators=fs-uae,amiberry,fellowng,copperline
        if [ "$#" -gt 0 ] && [ "${1#--}" = "$1" ]; then profile=$1; shift; fi
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --emulators) emulators=${2:?missing emulator list}; shift 2 ;;
                *) echo "unknown argument: $1" >&2; exit 64 ;;
            esac
        done
        root=${AMIGA_RUNTIME_EVIDENCE:-/work/evidence}
        mkdir -p "$root"
        summary="$root/compare.json"
        printf '{"schema":1,"profile":"%s","results":[' "$profile" >"$summary"
        first=true
        oldifs=$IFS; IFS=,
        for emulator in $emulators; do
            IFS=$oldifs
            case "$emulator" in fs-uae|amiberry|fellowng|copperline) ;; *) echo "unsupported emulator: $emulator" >&2; exit 65 ;; esac
            edir="$root/$emulator"; mkdir -p "$edir"
            set +e
            AMIGA_RUNTIME_EVIDENCE="$edir" "$0" qualify-aros-boot "$profile" --emulator "$emulator"
            rc=$?
            set -e
            [ "$first" = true ] || printf ',' >>"$summary"; first=false
            result_file=""
            for candidate in "$edir/result.json" "$edir/fellowng-result.json"; do
                if [ -s "$candidate" ]; then result_file="$candidate"; break; fi
            done
            printf '{"emulator":"%s","process_rc":%s,"status":"%s","evidence_dir":"%s","result_json":' \
                "$emulator" "$rc" "$([ "$rc" -eq 0 ] && printf PASS || printf FAIL)" "$emulator" >>"$summary"
            if [ -n "$result_file" ]; then
                python3 - "$result_file" <<'PY' >>"$summary"
import json, pathlib, sys
try:
    print(json.dumps(json.loads(pathlib.Path(sys.argv[1]).read_text()), separators=(",", ":")), end="")
except Exception:
    print("null", end="")
PY
            else
                printf 'null' >>"$summary"
            fi
            printf '}' >>"$summary"
            IFS=,
        done
        IFS=$oldifs
        printf ']}' >>"$summary"; printf '\n' >>"$summary"
        python3 - "$summary" <<'PY'
import json, pathlib, sys
p=pathlib.Path(sys.argv[1]); d=json.loads(p.read_text())
states={x["status"] for x in d["results"]}
d["status"]="PASS" if states=={"PASS"} else ("FAIL" if states=={"FAIL"} else "EMULATOR_DIVERGENCE")
p.write_text(json.dumps(d,indent=2)+"\n")
print(json.dumps(d,separators=(",",":")))
raise SystemExit(0 if d["status"]=="PASS" else 1)
PY
        ;;
    test-hunk)
        shift
        program=${1:-}
        test -n "$program" || { usage >&2; exit 64; }
        shift
        profile=amiga-ocs-68000-1m
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --profile) profile=${2:?missing profile}; shift 2 ;;
                *) echo "unknown argument: $1" >&2; exit 64 ;;
            esac
        done
        exec backend-fs-uae run-hunk "$program" "$profile"
        ;;
    test)
        shift
        program=${1:-}
        test -n "$program" || { usage >&2; exit 64; }
        shift
        runtime=aros
        profile=a1200-020
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --runtime) runtime=${2:?missing runtime}; shift 2 ;;
                --profile) profile=${2:?missing profile}; shift 2 ;;
                *) echo "unknown argument: $1" >&2; exit 64 ;;
            esac
        done
        case "$runtime" in
            aros|fs-uae) exec run-aros "$program" "$profile" ;;
            free-native) exec backend-fs-uae run-native-rom "$program" "$profile" ;;
            amiberry)
                shift_backend=run-aros
                exec backend-amiberry "$shift_backend" "$program" "$profile"
                ;;
            fellowng)
                exec backend-fellowng run "$program" "$profile"
                ;;
            *) echo "unsupported runtime backend: $runtime" >&2; exit 65 ;;
        esac
        ;;
    -h|--help|help|'') usage ;;
    *) usage >&2; exit 64 ;;
esac
