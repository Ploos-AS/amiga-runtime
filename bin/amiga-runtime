#!/bin/sh
set -eu

PROFILES=${AMIGA_RUNTIME_PROFILES:-/opt/amiga-runtime/profiles}

usage() {
    cat <<'EOF'
usage:
  amiga-runtime self-test
  amiga-runtime profiles
  amiga-runtime test PROGRAM [--runtime aros] [--profile PROFILE]
EOF
}

case "${1:-}" in
    self-test)
        command -v fs-uae >/dev/null
        command -v python3 >/dev/null
        test -d "$PROFILES"
        echo 'amiga-runtime M0 self-test: PASS'
        ;;
    profiles)
        find "$PROFILES" -maxdepth 1 -type f -name '*.conf' -printf '%f\n' | sed 's/\.conf$//' | sort
        ;;
    test)
        shift
        program=${1:-}
        test -n "$program" || { usage >&2; exit 64; }
        shift
        runtime=aros
        profile=a1200-020
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --runtime) runtime=${2:?missing runtime}; shift 2 ;;
                --profile) profile=${2:?missing profile}; shift 2 ;;
                *) echo "unknown argument: $1" >&2; exit 64 ;;
            esac
        done
        test "$runtime" = aros || { echo "M0 supports only the AROS contract" >&2; exit 65; }
        test -f "$PROFILES/$profile.conf" || { echo "unknown profile: $profile" >&2; exit 66; }
        echo "M0 contract OK: program=$program runtime=$runtime profile=$profile"
        echo 'Execution backend: PENDING (M1)'
        ;;
    -h|--help|help|'') usage ;;
    *) usage >&2; exit 64 ;;
esac
