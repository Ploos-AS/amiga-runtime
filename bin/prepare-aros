#!/bin/sh
set -eu

DEST=${AROS_RUNTIME_DIR:-/opt/amiga-runtime/aros}
PIN=${AROS_PIN_FILE:-/opt/amiga-runtime/runtime/aros/pinned.env}
mkdir -p "$DEST"

# shellcheck disable=SC1090
. "$PIN"

# SourceForge publishes only some targets on a given nightly. Discover the
# actual amiga-m68k boot ISO filename from the pinned build's Binaries listing
# instead of assuming a constructed URL is present.
sf_dir="https://sourceforge.net/projects/aros/files/nightly2/$AROS_BUILD_DATE/Binaries/"
listing="$DEST/sourceforge-binaries.html"

echo "Discovering AROS amiga-m68k boot ISO in $sf_dir" >&2
curl -fL --retry 3 --retry-all-errors --connect-timeout 20 \
    -A 'amiga-runtime/1.0 (+https://github.com/Ploos-AS/amiga-runtime)' \
    "$sf_dir" -o "$listing"

discovered=$(grep -Eo "AROS-${AROS_BUILD_DATE}-amiga-m68k-boot-iso\.zip" "$listing" | head -n1 || true)
test -n "$discovered" || {
    echo "Pinned AROS build $AROS_BUILD_DATE does not publish amiga-m68k-boot-iso" >&2
    exit 64
}

if [ -n "${AROS_ARCHIVE:-}" ] && [ "$AROS_ARCHIVE" != "$discovered" ]; then
    echo "Pinned archive name differs from SourceForge listing: $AROS_ARCHIVE != $discovered" >&2
    exit 64
fi
AROS_ARCHIVE=$discovered
archive="$DEST/$AROS_ARCHIVE"
md5file="$archive.md5"
archive_url="$sf_dir$AROS_ARCHIVE/download"
md5_url="$sf_dir$AROS_ARCHIVE.md5/download"

download() {
    output=$1
    url=$2
    echo "Downloading $url" >&2
    curl -fL --retry 3 --retry-all-errors --connect-timeout 20 \
        -A 'amiga-runtime/1.0 (+https://github.com/Ploos-AS/amiga-runtime)' \
        "$url" -o "$output.tmp"
    mv "$output.tmp" "$output"
}

download "$archive" "$archive_url"
download "$md5file" "$md5_url"

expected=$(awk '{print $1}' "$md5file" | head -n1)
actual=$(md5sum "$archive" | awk '{print $1}')
case "$expected" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*) ;;
    *) echo "Invalid upstream checksum response" >&2; exit 65 ;;
esac
test "$actual" = "$expected" || {
    echo "AROS upstream checksum mismatch" >&2
    exit 65
}

actual_sha256=$(sha256sum "$archive" | awk '{print $1}')
if [ -n "${AROS_SHA256:-}" ]; then
    test "$actual_sha256" = "$AROS_SHA256" || {
        echo "AROS pinned SHA-256 mismatch" >&2
        exit 65
    }
fi
printf '%s  %s\n' "$actual_sha256" "$AROS_ARCHIVE" | tee "$DEST/archive.sha256"

rm -rf "$DEST/unpacked" "$DEST/iso-root"
mkdir -p "$DEST/unpacked" "$DEST/iso-root"
unzip -q "$archive" -d "$DEST/unpacked"
iso=$(find "$DEST/unpacked" -type f -iname '*.iso' -print -quit)
test -n "$iso" || { echo 'AROS ISO not found in archive' >&2; exit 66; }
cp "$iso" "$DEST/aros.iso"
xorriso -osirrox on -indev "$DEST/aros.iso" -extract / "$DEST/iso-root" >/dev/null 2>&1

rom=$(find "$DEST/iso-root" -type f -iname 'aros-rom.bin' -print -quit)
ext=$(find "$DEST/iso-root" -type f -iname 'aros-ext.bin' -print -quit)
test -n "$rom" && test -n "$ext" || { echo 'AROS m68k ROM pair not found in ISO' >&2; exit 66; }
cp "$rom" "$DEST/aros-rom.bin"
cp "$ext" "$DEST/aros-ext.bin"

{
  echo "build_date=$AROS_BUILD_DATE"
  echo "archive=$AROS_ARCHIVE"
  echo "source_url=$archive_url"
  echo "md5=$actual"
  echo "sha256=$actual_sha256"
  echo "rom_sha256=$(sha256sum "$DEST/aros-rom.bin" | awk '{print $1}')"
  echo "ext_sha256=$(sha256sum "$DEST/aros-ext.bin" | awk '{print $1}')"
} > "$DEST/manifest.txt"
cat "$DEST/manifest.txt"
echo 'AROS m68k runtime prepared: PASS'
