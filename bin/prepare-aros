#!/bin/sh
set -eu

DEST=${AROS_RUNTIME_DIR:-/opt/amiga-runtime/aros}
PIN=${AROS_PIN_FILE:-/opt/amiga-runtime/runtime/aros/pinned.env}
mkdir -p "$DEST"

# shellcheck disable=SC1090
. "$PIN"

: "${AROS_BUILD_DATE:?AROS_BUILD_DATE is required}"
: "${AROS_ARCHIVE:?AROS_ARCHIVE is required}"
: "${AROS_FLOPPY_ARCHIVE:?AROS_FLOPPY_ARCHIVE is required}"

expected_archive="AROS-${AROS_BUILD_DATE}-amiga-m68k-boot-iso.zip"
expected_floppy="AROS-${AROS_BUILD_DATE}-amiga-m68k-boot-floppy.lha"
test "$AROS_ARCHIVE" = "$expected_archive" || { echo "Pinned archive is not the expected amiga-m68k boot ISO: $AROS_ARCHIVE" >&2; exit 64; }
test "$AROS_FLOPPY_ARCHIVE" = "$expected_floppy" || { echo "Pinned archive is not the expected amiga-m68k boot floppy: $AROS_FLOPPY_ARCHIVE" >&2; exit 64; }

base="https://sourceforge.net/projects/aros/files/nightly2/$AROS_BUILD_DATE/Binaries"
archive_url="$base/$AROS_ARCHIVE/download"
md5_url="$base/$AROS_ARCHIVE.md5/download"
floppy_url="$base/$AROS_FLOPPY_ARCHIVE/download"
floppy_md5_url="$base/$AROS_FLOPPY_ARCHIVE.md5/download"
archive="$DEST/$AROS_ARCHIVE"
md5file="$archive.md5"
floppy_archive="$DEST/$AROS_FLOPPY_ARCHIVE"
floppy_md5file="$floppy_archive.md5"

download() {
    output=$1
    url=$2
    echo "Downloading $url" >&2
    curl -fL --retry 3 --retry-all-errors --connect-timeout 20 \
        -A 'amiga-runtime/1.0 (+https://github.com/Ploos-AS/amiga-runtime)' \
        "$url" -o "$output.tmp"
    mv "$output.tmp" "$output"
}

verify_md5() {
    payload=$1
    checksum=$2
    expected=$(awk '{print $1}' "$checksum" | head -n1)
    actual=$(md5sum "$payload" | awk '{print $1}')
    case "$expected" in
        [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*) ;;
        *) echo "Invalid upstream checksum response for $payload" >&2; exit 65 ;;
    esac
    test "$actual" = "$expected" || { echo "AROS upstream checksum mismatch for $payload" >&2; exit 65; }
    printf '%s' "$actual"
}

download "$archive" "$archive_url"
download "$md5file" "$md5_url"
download "$floppy_archive" "$floppy_url"
download "$floppy_md5file" "$floppy_md5_url"

actual=$(verify_md5 "$archive" "$md5file")
floppy_md5=$(verify_md5 "$floppy_archive" "$floppy_md5file")
actual_sha256=$(sha256sum "$archive" | awk '{print $1}')
floppy_sha256=$(sha256sum "$floppy_archive" | awk '{print $1}')
if [ -n "${AROS_SHA256:-}" ]; then
    test "$actual_sha256" = "$AROS_SHA256" || { echo "AROS pinned SHA-256 mismatch" >&2; exit 65; }
fi
if [ -n "${AROS_FLOPPY_SHA256:-}" ]; then
    test "$floppy_sha256" = "$AROS_FLOPPY_SHA256" || { echo "AROS floppy pinned SHA-256 mismatch" >&2; exit 65; }
fi
{
    printf '%s  %s\n' "$actual_sha256" "$AROS_ARCHIVE"
    printf '%s  %s\n' "$floppy_sha256" "$AROS_FLOPPY_ARCHIVE"
} | tee "$DEST/archive.sha256"

rm -rf "$DEST/unpacked" "$DEST/iso-root" "$DEST/floppy-unpacked"
mkdir -p "$DEST/unpacked" "$DEST/iso-root" "$DEST/floppy-unpacked"
unzip -q "$archive" -d "$DEST/unpacked"
iso=$(find "$DEST/unpacked" -type f -iname '*.iso' -print -quit)
test -n "$iso" || { echo 'AROS ISO not found in archive' >&2; exit 66; }
cp "$iso" "$DEST/aros.iso"
xorriso -osirrox on -indev "$DEST/aros.iso" -extract / "$DEST/iso-root" >/dev/null 2>&1

rom=$(find "$DEST/iso-root" -type f -iname 'aros-rom.bin' -print -quit)
ext=$(find "$DEST/iso-root" -type f -iname 'aros-ext.bin' -print -quit)
test -n "$rom" && test -n "$ext" || { echo 'AROS m68k ROM pair not found in ISO' >&2; exit 66; }
cp "$rom" "$DEST/aros-rom.bin"
cp "$ext" "$DEST/aros-ext.bin"

bsdtar -xf "$floppy_archive" -C "$DEST/floppy-unpacked"
adf=$(find "$DEST/floppy-unpacked" -type f \( -iname '*.adf' -o -iname '*.img' \) -print -quit)
test -n "$adf" || { echo 'AROS m68k boot floppy image not found in archive' >&2; exit 66; }
cp "$adf" "$DEST/aros-boot.adf"

{
  echo "build_date=$AROS_BUILD_DATE"
  echo "archive=$AROS_ARCHIVE"
  echo "source_url=$archive_url"
  echo "md5=$actual"
  echo "sha256=$actual_sha256"
  echo "floppy_archive=$AROS_FLOPPY_ARCHIVE"
  echo "floppy_source_url=$floppy_url"
  echo "floppy_md5=$floppy_md5"
  echo "floppy_sha256=$floppy_sha256"
  echo "boot_adf_sha256=$(sha256sum "$DEST/aros-boot.adf" | awk '{print $1}')"
  echo "rom_sha256=$(sha256sum "$DEST/aros-rom.bin" | awk '{print $1}')"
  echo "ext_sha256=$(sha256sum "$DEST/aros-ext.bin" | awk '{print $1}')"
} > "$DEST/manifest.txt"
cat "$DEST/manifest.txt"
echo 'AROS m68k runtime prepared: PASS'
