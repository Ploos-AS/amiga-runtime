#!/bin/sh
set -eu

DEST=${AROS_RUNTIME_DIR:-/opt/amiga-runtime/aros}
PIN=${AROS_PIN_FILE:-/opt/amiga-runtime/runtime/aros/pinned.env}
WORK=${AROS_PREPARE_WORKDIR:-/tmp/amiga-runtime-aros}
mkdir -p "$DEST"

# shellcheck disable=SC1090
. "$PIN"

: "${AROS_INDEX_URL:?AROS_INDEX_URL is required}"
: "${AROS_TARGET:?AROS_TARGET is required}"
test "$AROS_TARGET" = amiga-m68k-boot-iso || {
    echo "Unsupported AROS target: $AROS_TARGET" >&2
    exit 64
}

rm -rf "$WORK"
mkdir -p "$WORK"
index="$WORK/aros-nightly-index.html"

# Resolve through the official AROS nightly index. SourceForge nightly folders
# are rolling, so previously valid dated paths can disappear.
curl --fail --location --retry 4 --retry-delay 2 "$AROS_INDEX_URL" -o "$index"
url=$({ grep -oE 'href="[^"]*amiga-m68k-boot-iso[^"]*"' "$index" || true; } |
    head -n1 | sed -e 's/^href="//' -e 's/"$//' -e 's/&amp;/\&/g')
test -n "$url" || {
    echo "Could not resolve AROS amiga-m68k nightly from official index" >&2
    exit 65
}
case "$url" in
    http://*|https://*) ;;
    //*) url="https:$url" ;;
    /*) url="https://aros.sourceforge.io$url" ;;
    *) url="https://aros.sourceforge.io/$url" ;;
esac

path=${url%%\?*}
case "$path" in
    */download) archive_name=$(basename "$(dirname "$path")") ;;
    *) archive_name=$(basename "$path") ;;
esac
case "$archive_name" in
    *amiga-m68k-boot-iso*) ;;
    *) echo "Refusing unexpected AROS artifact: $archive_name" >&2; exit 64 ;;
esac

archive="$WORK/$archive_name"
curl --fail --location --retry 4 --retry-delay 2 --output "$archive" "$url"
archive_sha256=$(sha256sum "$archive" | awk '{print $1}')

type=$(file -b "$archive")
mkdir -p "$WORK/unpacked"
case "$archive_name" in
    *.zip|*.ZIP) unzip -q "$archive" -d "$WORK/unpacked" ;;
    *.lha|*.LHA) lha xw="$WORK/unpacked" "$archive" >/dev/null ;;
    *) echo "Unsupported AROS archive format: $archive_name ($type)" >&2; exit 66 ;;
esac
iso=$(find "$WORK/unpacked" -type f -iname '*.iso' -print -quit)
test -n "$iso" || { echo 'AROS amiga-m68k ISO not found in upstream archive' >&2; exit 66; }

rm -rf "$DEST/iso-root"
mkdir -p "$DEST/iso-root"
cp "$iso" "$DEST/aros.iso"
xorriso -osirrox on -indev "$DEST/aros.iso" -extract / "$DEST/iso-root" >/dev/null 2>&1
rom=$(find "$DEST/iso-root" -type f -iname 'aros-rom.bin' -print -quit)
ext=$(find "$DEST/iso-root" -type f -iname 'aros-ext.bin' -print -quit)
test -n "$rom" && test -n "$ext" || { echo 'AROS m68k ROM pair not found in upstream ISO' >&2; exit 66; }
cp "$rom" "$DEST/aros-rom.bin"
cp "$ext" "$DEST/aros-ext.bin"

iso_sha256=$(sha256sum "$DEST/aros.iso" | awk '{print $1}')
rom_sha256=$(sha256sum "$DEST/aros-rom.bin" | awk '{print $1}')
ext_sha256=$(sha256sum "$DEST/aros-ext.bin" | awk '{print $1}')
printf '%s  %s\n' "$archive_sha256" "$archive_name" > "$DEST/archive.sha256"
{
    echo 'acquisition=official-nightly-index'
    echo 'target=amiga-m68k'
    echo "index_url=$AROS_INDEX_URL"
    echo "archive=$archive_name"
    echo "archive_url=$url"
    echo "archive_sha256=$archive_sha256"
    echo "iso_sha256=$iso_sha256"
    echo "rom_sha256=$rom_sha256"
    echo "ext_sha256=$ext_sha256"
} > "$DEST/manifest.txt"
cat "$DEST/manifest.txt"
echo 'AROS m68k runtime prepared: PASS'
