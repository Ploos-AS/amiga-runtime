#!/bin/sh
set -eu

DEST=${AROS_RUNTIME_DIR:-/opt/amiga-runtime/aros}
PIN=${AROS_PIN_FILE:-/opt/amiga-runtime/runtime/aros/pinned.env}
WORK=${AROS_PREPARE_WORKDIR:-/tmp/amiga-runtime-aros}
mkdir -p "$DEST"

# shellcheck disable=SC1090
. "$PIN"

: "${AROS_BUILD_DATE:?AROS_BUILD_DATE is required}"
: "${AROS_ARCHIVE:?AROS_ARCHIVE is required}"
: "${AROS_ARCHIVE_URL:?AROS_ARCHIVE_URL is required}"
: "${AROS_MD5_URL:?AROS_MD5_URL is required}"
: "${AROS_TARGET:?AROS_TARGET is required}"
test "$AROS_TARGET" = amiga-m68k || { echo "Unsupported AROS target: $AROS_TARGET" >&2; exit 64; }
case "$AROS_ARCHIVE" in
  *amiga-m68k*) ;;
  *) echo "Refusing non-amiga-m68k AROS artifact: $AROS_ARCHIVE" >&2; exit 64 ;;
esac

rm -rf "$WORK"
mkdir -p "$WORK"
archive="$WORK/$AROS_ARCHIVE"
sidecar="$WORK/$AROS_ARCHIVE.md5"

curl --fail --location --retry 4 --retry-delay 2 --output "$archive" "$AROS_ARCHIVE_URL"
curl --fail --location --retry 4 --retry-delay 2 --output "$sidecar" "$AROS_MD5_URL"

expected_md5=$(awk 'NF { for (i=1; i<=NF; i++) if ($i ~ /^[0-9A-Fa-f]{32}$/) { print tolower($i); exit } }' "$sidecar")
test -n "$expected_md5" || { echo 'Could not parse upstream AROS MD5 sidecar' >&2; exit 65; }
actual_md5=$(md5sum "$archive" | awk '{print $1}')
test "$actual_md5" = "$expected_md5" || { echo "AROS archive MD5 mismatch: expected $expected_md5 got $actual_md5" >&2; exit 65; }
archive_sha256=$(sha256sum "$archive" | awk '{print $1}')

type=$(file -b "$archive")
case "$type" in
  *Zip*) ;;
  *) echo "Unexpected AROS archive type: $type" >&2; exit 66 ;;
esac

mkdir -p "$WORK/unpacked"
unzip -q "$archive" -d "$WORK/unpacked"
iso=$(find "$WORK/unpacked" -type f -iname '*.iso' -print -quit)
test -n "$iso" || { echo 'AROS amiga-m68k ISO not found in upstream archive' >&2; exit 66; }

rm -rf "$DEST/iso-root"
mkdir -p "$DEST/iso-root"
cp "$iso" "$DEST/aros.iso"
xorriso -osirrox on -indev "$DEST/aros.iso" -extract / "$DEST/iso-root" >/dev/null 2>&1
rom=$(find "$DEST/iso-root" -type f -iname 'aros-rom.bin' -print -quit)
ext=$(find "$DEST/iso-root" -type f -iname 'aros-ext.bin' -print -quit)
test -n "$rom" && test -n "$ext" || { echo 'AROS m68k ROM pair not found in upstream ISO' >&2; exit 66; }
cp "$rom" "$DEST/aros-rom.bin"
cp "$ext" "$DEST/aros-ext.bin"

iso_sha256=$(sha256sum "$DEST/aros.iso" | awk '{print $1}')
rom_sha256=$(sha256sum "$DEST/aros-rom.bin" | awk '{print $1}')
ext_sha256=$(sha256sum "$DEST/aros-ext.bin" | awk '{print $1}')
printf '%s  %s\n' "$archive_sha256" "$AROS_ARCHIVE" > "$DEST/archive.sha256"
{
    echo 'acquisition=upstream-prebuilt'
    echo "build_date=$AROS_BUILD_DATE"
    echo "target=$AROS_TARGET"
    echo "archive=$AROS_ARCHIVE"
    echo "archive_url=$AROS_ARCHIVE_URL"
    echo "upstream_md5=$actual_md5"
    echo "archive_sha256=$archive_sha256"
    echo "iso_sha256=$iso_sha256"
    echo "rom_sha256=$rom_sha256"
    echo "ext_sha256=$ext_sha256"
} > "$DEST/manifest.txt"
cat "$DEST/manifest.txt"
echo 'Pinned prebuilt AROS m68k runtime prepared: PASS'
