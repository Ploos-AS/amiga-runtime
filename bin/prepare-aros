#!/bin/sh
set -eu

DEST=${AROS_RUNTIME_DIR:-/opt/amiga-runtime/aros}
PIN=${AROS_PIN_FILE:-/opt/amiga-runtime/runtime/aros/pinned.env}
# runtime/ is copied to /opt/amiga-runtime/runtime in the image; keep a
# compatibility fallback for older image layouts that copied its contents one
# level higher.
if [ ! -f "$PIN" ] && [ -f /opt/amiga-runtime/aros/pinned.env ]; then
    PIN=/opt/amiga-runtime/aros/pinned.env
fi
test -f "$PIN" || { echo "AROS pin file not found: $PIN" >&2; exit 66; }
WORK=${AROS_PREPARE_WORKDIR:-/tmp/amiga-runtime-aros}
mkdir -p "$DEST"

# shellcheck disable=SC1090
. "$PIN"

AROS_INDEX_URL=${AROS_INDEX_URL:-https://aros.sourceforge.io/cgi-bin/files?lang=en&type=nightly2}
AROS_TARGET=${AROS_TARGET:-amiga-m68k-boot-iso}
test "$AROS_TARGET" = amiga-m68k-boot-iso || {
    echo "Unsupported AROS target: $AROS_TARGET" >&2
    exit 64
}

rm -rf "$WORK"
mkdir -p "$WORK"
index="$WORK/aros-nightly-index.html"

# Resolve through the official AROS nightly index. SourceForge nightly folders
# are rolling, so previously valid dated paths can disappear.
curl --fail --location --retry 4 --retry-delay 2 "$AROS_INDEX_URL" -o "$index"
url=$({ grep -oE 'href="[^"]*amiga-m68k-boot-iso[^"]*"' "$index" || true; } |
    head -n1 | sed -e 's/^href="//' -e 's/"$//' -e 's/&amp;/\&/g')
test -n "$url" || {
    echo "Could not resolve AROS amiga-m68k nightly from official index" >&2
    exit 65
}
case "$url" in
    http://*|https://*) ;;
    //*) url="https:$url" ;;
    /*) url="https://aros.sourceforge.io$url" ;;
    *) url="https://aros.sourceforge.io/$url" ;;
esac

path=${url%%\?*}
case "$path" in
    */download) archive_name=$(basename "$(dirname "$path")") ;;
    *) archive_name=$(basename "$path") ;;
esac
case "$archive_name" in
    *amiga-m68k-boot-iso*) ;;
    *) echo "Refusing unexpected AROS artifact: $archive_name" >&2; exit 64 ;;
esac

archive="$WORK/$archive_name"
curl --fail --location --retry 4 --retry-delay 2 --output "$archive" "$url"
archive_sha256=$(sha256sum "$archive" | awk '{print $1}')

type=$(file -b "$archive")
mkdir -p "$WORK/unpacked"
case "$archive_name" in
    *.zip|*.ZIP) unzip -q "$archive" -d "$WORK/unpacked" ;;
    *.lha|*.LHA) lha xw="$WORK/unpacked" "$archive" >/dev/null ;;
    *) echo "Unsupported AROS archive format: $archive_name ($type)" >&2; exit 66 ;;
esac
iso=$(find "$WORK/unpacked" -type f -iname '*.iso' -print -quit)
test -n "$iso" || { echo 'AROS amiga-m68k ISO not found in upstream archive' >&2; exit 66; }

rm -rf "$DEST/iso-root"
mkdir -p "$DEST/iso-root"
cp "$iso" "$DEST/aros.iso"
# Keep the legacy 7z probe for comparison with earlier AROS nightlies.
7z x -y -o"$DEST/iso-root" "$DEST/aros.iso" >/dev/null || true
# 7z is the proven extraction path for the bootable directory volume, but it
# does not expose the ISO's Amiga-specific ROM entries the same way xorriso
# does. Extract only the ROM pair through xorriso into a temporary tree.
romtree="$WORK/rom-root"
mkdir -p "$romtree"
xorriso -osirrox on -indev "$DEST/aros.iso" -extract / "$romtree" >/dev/null 2>&1
(
    cd "$romtree"
    find . -maxdepth 8 -printf '%y %p\n' | LC_ALL=C sort
) > "$DEST/xorriso-root-inventory.txt"
xstartup=$(find "$romtree" -type f -ipath '*/s/startup-sequence' -print -quit || true)
if [ -n "$xstartup" ]; then
    printf '%s\n' "$xstartup" > "$DEST/xorriso-startup-sequence-path.txt"
else
    printf '%s\n' 'NOT_FOUND' > "$DEST/xorriso-startup-sequence-path.txt"
fi
rom=$(find "$romtree" -type f -iname 'aros-rom.bin' -print -quit)
ext=$(find "$romtree" -type f -iname 'aros-ext.bin' -print -quit)
test -n "$rom" && test -n "$ext" || { echo 'AROS m68k ROM pair not found in upstream ISO' >&2; exit 66; }
cp "$rom" "$DEST/aros-rom.bin"
cp "$ext" "$DEST/aros-ext.bin"

# Preserve a deterministic inventory of the 7z-extracted filesystem so CI
# failures can be diagnosed from artifacts instead of inferred from layout.
(
    cd "$DEST/iso-root"
    find . -maxdepth 5 -printf '%y %p\n' | LC_ALL=C sort
) > "$DEST/iso-root-inventory.txt"

startup=$(find "$DEST/iso-root" -type f -ipath '*/s/startup-sequence' -print -quit || true)
if [ -n "$startup" ]; then
    printf '%s\n' "$startup" > "$DEST/startup-sequence-path.txt"
else
    printf '%s\n' 'NOT_FOUND' > "$DEST/startup-sequence-path.txt"
fi

iso_sha256=$(sha256sum "$DEST/aros.iso" | awk '{print $1}')
rom_sha256=$(sha256sum "$DEST/aros-rom.bin" | awk '{print $1}')
ext_sha256=$(sha256sum "$DEST/aros-ext.bin" | awk '{print $1}')
printf '%s  %s\n' "$archive_sha256" "$archive_name" > "$DEST/archive.sha256"
{
    echo 'acquisition=official-nightly-index'
    echo 'target=amiga-m68k'
    echo "index_url=$AROS_INDEX_URL"
    echo "archive=$archive_name"
    echo "archive_url=$url"
    echo "archive_sha256=$archive_sha256"
    echo "iso_sha256=$iso_sha256"
    echo "rom_sha256=$rom_sha256"
    echo "ext_sha256=$ext_sha256"
} > "$DEST/manifest.txt"
cat "$DEST/manifest.txt"
echo 'AROS m68k runtime prepared: PASS'
