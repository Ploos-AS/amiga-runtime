#!/bin/sh
set -eu

DEST=${AROS_RUNTIME_DIR:-/opt/amiga-runtime/aros}
PIN=${AROS_PIN_FILE:-/opt/amiga-runtime/runtime/aros/pinned.env}
mkdir -p "$DEST"

# shellcheck disable=SC1090
. "$PIN"
archive="$DEST/$AROS_ARCHIVE"
md5file="$archive.md5"

# SourceForge's mirror/download routing changes over time. Keep the pinned
# build identity in pinned.env, but try canonical routes instead of depending
# on one hard-coded mirror hostname/path.
download() {
    output=$1
    shift
    for url in "$@"; do
        echo "Trying $url" >&2
        if curl -fL --retry 3 --retry-all-errors --connect-timeout 20 \
            -A 'amiga-runtime/1.0 (+https://github.com/Ploos-AS/amiga-runtime)' \
            "$url" -o "$output.tmp"; then
            mv "$output.tmp" "$output"
            return 0
        fi
        rm -f "$output.tmp"
    done
    return 1
}

sf_base="https://sourceforge.net/projects/aros/files/nightly2/$AROS_BUILD_DATE/Binaries"
mirror_base="https://downloads.sourceforge.net/project/aros/nightly2/$AROS_BUILD_DATE/Binaries"

download "$archive" \
    "$AROS_URL" \
    "$sf_base/$AROS_ARCHIVE?download=1" \
    "$mirror_base/$AROS_ARCHIVE" || {
        echo "Unable to download pinned AROS archive: $AROS_ARCHIVE" >&2
        exit 64
    }

download "$md5file" \
    "$AROS_MD5_URL" \
    "$sf_base/$AROS_ARCHIVE.md5?download=1" \
    "$mirror_base/$AROS_ARCHIVE.md5" || {
        echo "Unable to download checksum for pinned AROS archive" >&2
        exit 64
    }

expected=$(awk '{print $1}' "$md5file" | head -n1)
actual=$(md5sum "$archive" | awk '{print $1}')
case "$expected" in
    [0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]*) ;;
    *) echo "Invalid upstream checksum response" >&2; exit 65 ;;
esac
test "$actual" = "$expected" || {
    echo "AROS upstream checksum mismatch" >&2
    exit 65
}
sha256sum "$archive" | tee "$DEST/archive.sha256"

rm -rf "$DEST/unpacked" "$DEST/iso-root"
mkdir -p "$DEST/unpacked" "$DEST/iso-root"
unzip -q "$archive" -d "$DEST/unpacked"
iso=$(find "$DEST/unpacked" -type f -iname '*.iso' -print -quit)
test -n "$iso" || { echo 'AROS ISO not found in archive' >&2; exit 66; }
cp "$iso" "$DEST/aros.iso"
xorriso -osirrox on -indev "$DEST/aros.iso" -extract / "$DEST/iso-root" >/dev/null 2>&1

rom=$(find "$DEST/iso-root" -type f -iname 'aros-rom.bin' -print -quit)
ext=$(find "$DEST/iso-root" -type f -iname 'aros-ext.bin' -print -quit)
test -n "$rom" && test -n "$ext" || { echo 'AROS m68k ROM pair not found in ISO' >&2; exit 66; }
cp "$rom" "$DEST/aros-rom.bin"
cp "$ext" "$DEST/aros-ext.bin"

{
  echo "build_date=$AROS_BUILD_DATE"
  echo "archive=$AROS_ARCHIVE"
  echo "md5=$actual"
  echo "sha256=$(sha256sum "$archive" | awk '{print $1}')"
  echo "rom_sha256=$(sha256sum "$DEST/aros-rom.bin" | awk '{print $1}')"
  echo "ext_sha256=$(sha256sum "$DEST/aros-ext.bin" | awk '{print $1}')"
} > "$DEST/manifest.txt"
cat "$DEST/manifest.txt"
echo 'AROS m68k runtime prepared: PASS'
