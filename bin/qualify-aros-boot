#!/bin/sh
set -eu

AROS=${AROS_RUNTIME_DIR:-/opt/amiga-runtime/aros}
EVIDENCE=${AMIGA_RUNTIME_EVIDENCE:-/work/evidence}
TIMEOUT=${AMIGA_RUNTIME_BOOT_TIMEOUT:-20}
PROFILE=${1:-a1200-020}
PROFILES=${AMIGA_RUNTIME_PROFILES:-/opt/amiga-runtime/profiles}
GENERATOR=${AMIGA_RUNTIME_FS_UAE_GENERATOR:-/opt/amiga-runtime/lib/generate-fs-uae-config.py}

mkdir -p "$EVIDENCE"
for f in "$AROS/aros.iso" "$AROS/aros-rom.bin" "$AROS/aros-ext.bin"; do
    test -s "$f" || { echo "missing prepared AROS artifact: $f" >&2; exit 69; }
done
profile="$PROFILES/$PROFILE.conf"
test -f "$profile" || { echo "unknown profile: $PROFILE" >&2; exit 66; }
test -f "$GENERATOR" || { echo "missing FS-UAE config generator: $GENERATOR" >&2; exit 69; }

sha256sum "$AROS/aros.iso" "$AROS/aros-rom.bin" "$AROS/aros-ext.bin" > "$EVIDENCE/runtime.sha256"
config="$EVIDENCE/fs-uae.conf"
python3 "$GENERATOR" "$profile" "$AROS/aros-rom.bin" "$AROS/aros-ext.bin" "$AROS/aros.iso" "$config"

# M1 currently proves only emulator/process startup. It deliberately does not
# call this a guest boot PASS; deterministic guest markers are the next gate.
set +e
timeout "$TIMEOUT" fs-uae "$config" \
    >"$EVIDENCE/fs-uae.stdout.log" 2>"$EVIDENCE/fs-uae.stderr.log"
rc=$?
set -e

case "$rc" in
    0|124) emulator_started=true ;;
    *) emulator_started=false ;;
esac

python3 - "$EVIDENCE/result.json" "$rc" "$PROFILE" "$emulator_started" <<'PY'
import json, pathlib, sys
out, rc, profile, started = sys.argv[1:]
data = {
    "schema": 1,
    "milestone": "M1",
    "qualification_level": "Q2-foundation",
    "runtime": "aros-m68k",
    "emulator": "fs-uae",
    "profile": profile,
    "process_rc": int(rc),
    "emulator_started": started == "true",
    "guest_boot_proven": False,
    "status": "PASS" if started == "true" else "FAIL",
    "boundary": "M1 emulator start gate only; guest marker proof is required before runtime qualification"
}
pathlib.Path(out).write_text(json.dumps(data, indent=2) + "\n")
PY

[ "$emulator_started" = true ]
echo 'AROS FS-UAE emulator start gate: PASS (guest boot remains unproven)'
