#!/bin/sh
set -eu
PIN=${AMIBERRY_PIN:-/opt/amiga-runtime/runtime/amiberry/pinned.env}
DEST=${AMIBERRY_RUNTIME_DIR:-/opt/amiga-runtime/amiberry}
. "$PIN"
archive="$DEST/$AMIBERRY_LINUX_AMD64_ASSET"
url="$AMIBERRY_RELEASE_REPOSITORY/releases/download/v$AMIBERRY_VERSION/$AMIBERRY_LINUX_AMD64_ASSET"
mkdir -p "$DEST"
curl -fL --retry 3 "$url" -o "$archive"
printf '%s  %s\n' "$AMIBERRY_LINUX_AMD64_SHA256" "$archive" | sha256sum -c -
rm -rf "$DEST/root"
mkdir -p "$DEST/root"
unzip -q "$archive" -d "$DEST/root"
exe=$(find "$DEST/root" -type f -name amiberry -print -quit)
test -n "$exe" || { echo "Amiberry executable not found in pinned artifact" >&2; exit 66; }
chmod 0755 "$exe"
printf 'version=%s\nasset=%s\nsha256=%s\n' "$AMIBERRY_VERSION" "$AMIBERRY_LINUX_AMD64_ASSET" "$AMIBERRY_LINUX_AMD64_SHA256" > "$DEST/manifest.txt"
printf '%s\n' "$exe" > "$DEST/executable.txt"
echo "Amiberry $AMIBERRY_VERSION prepared"
