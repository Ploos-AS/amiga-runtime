#!/bin/sh
set -eu
PIN=${COPPERLINE_PIN:-/opt/amiga-runtime/runtime/copperline/pinned.env}
DEST=${COPPERLINE_RUNTIME_DIR:-/opt/amiga-runtime/copperline}
. "$PIN"
mkdir -p "$DEST"
asset="${COPPERLINE_LINUX_AMD64_ASSET}"
url="$COPPERLINE_RELEASE_REPOSITORY/releases/download/v$COPPERLINE_VERSION/$asset"
curl -fL --retry 3 "$url" -o "$DEST/copperline"
chmod 0755 "$DEST/copperline"
# AppImages require FUSE when executed directly. Extract once so the runtime
# works inside unprivileged OCI containers and GitHub-hosted runners.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
(cd "$tmp" && "$DEST/copperline" --appimage-extract >/dev/null)
rm -rf "$DEST/appdir"
mv "$tmp/squashfs-root" "$DEST/appdir"
ln -sf "$DEST/appdir/AppRun" "$DEST/copperline-bin"
printf 'version=%s\nasset=%s\nsource=%s\n' "$COPPERLINE_VERSION" "$asset" "$COPPERLINE_RELEASE_REPOSITORY" >"$DEST/manifest.txt"
